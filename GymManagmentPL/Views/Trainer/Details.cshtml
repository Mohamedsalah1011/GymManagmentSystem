@model TrainerViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <!-- Header Section -->
                <div class="bg-primary text-white text-center py-4 px-3" style="background-color: #0b0099 !important;">
                    <div class="mb-2">
                        <i class="bi bi-person-badge fs-1"></i>
                    </div>
                    <h3 class="mb-1 fw-bold">@Model.Name</h3>
                    <span class="badge rounded-pill bg-light text-primary px-3 py-1 fw-bold">@Model.Specialty Trainer</span>
                </div>

                <!-- Body Section -->
                <div class="card-body p-4">
                    <div class="d-flex flex-column gap-3">
                        
                        <!-- Email -->
                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3">
                            <div class="d-flex align-items-center justify-content-center bg-white rounded-3 shadow-sm" style="width: 45px; height: 45px;">
                                <i class="bi bi-envelope text-primary fs-4"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">Email</small>
                                <strong class="text-dark">@Model.Email</strong>
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3">
                            <div class="d-flex align-items-center justify-content-center bg-white rounded-3 shadow-sm" style="width: 45px; height: 45px;">
                                <i class="bi bi-telephone text-primary fs-4"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">Phone</small>
                                <strong class="text-dark">@Model.Phone</strong>
                            </div>
                        </div>

                        <!-- Date Of Birth -->
                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3">
                            <div class="d-flex align-items-center justify-content-center bg-white rounded-3 shadow-sm" style="width: 45px; height: 45px;">
                                <i class="bi bi-calendar3 text-primary fs-4"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">Date Of Birth</small>
                                <strong class="text-dark">@Model.DateOfBirth</strong>
                            </div>
                        </div>

                        <!-- Address -->
                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3">
                            <div class="d-flex align-items-center justify-content-center bg-white rounded-3 shadow-sm" style="width: 45px; height: 45px;">
                                <i class="bi bi-geo-alt text-primary fs-4"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">Address</small>
                                <strong class="text-dark">@Model.Address</strong>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Footer Section -->
                <div class="px-4 pb-4">
                    <a asp-controller="Trainer" asp-action="Index" class="btn w-100 text-white py-3 fw-bold rounded-3" style="background-color: #0b0099;">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
