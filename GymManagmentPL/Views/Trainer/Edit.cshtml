@model TrainerToUpdateViewModel
@{
    ViewData["Title"] = "Edite Trainers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-4 rounded-3">
                <div class="mb-4">
                    <small class="text-muted d-block">Editing Profile For</small>
                    <h2 class="fw-bold text-dark">@Model.Name</h2>
                </div>

                <form method="post" asp-action="Edit">
                    <input type="hidden" asp-for="Name" />

                    <!-- Personal Information -->
                    <h5 class="text-primary fw-bold mb-3">Personal Information</h5>
                    <hr class="mb-4">

                    <div class="row g-3 mb-4">
                        <!-- Email -->
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="Enter email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="Enter phone number" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <!-- Building Number -->
                        <div class="col-md-6">
                            <label asp-for="BuildingNumber" class="form-label">Building Number <span class="text-danger">*</span></label>
                            <input asp-for="BuildingNumber" class="form-control" />
                            <span asp-validation-for="BuildingNumber" class="text-danger"></span>
                        </div>

                        <!-- City -->
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label">City <span class="text-danger">*</span></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <!-- Street -->
                        <div class="col-md-12">
                            <label asp-for="Street" class="form-label">Street <span class="text-danger">*</span></label>
                            <input asp-for="Street" class="form-control" />
                            <span asp-validation-for="Street" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Professional Information -->
                    <h5 class="text-primary fw-bold mb-3">Professional Information</h5>
                    <hr class="mb-4">

                    <div class="mb-4">
                        <label class="form-label d-block fw-semibold mb-2">Specializations <span class="text-danger">*</span></label>
                        @foreach (var specialty in Html.GetEnumSelectList<GymManagmentDAL.Entites.Enums.Specialties>())
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" asp-for="Specialty" value="@specialty.Value" id="specialty-@specialty.Value" />
                                <label class="form-check-label text-muted" for="specialty-@specialty.Value">
                                    @specialty.Text
                                </label>
                            </div>
                        }
                        <span asp-validation-for="Specialty" class="text-danger"></span>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2" style="border-color: #0b0099; color: #0b0099;">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn text-white px-4 py-2" style="background-color: #0b0099;">
                            <i class="bi bi-check2 me-1"></i> Update Trainer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
